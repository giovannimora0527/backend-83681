# Copia este archivo a .env y cambia las contraseñas antes de iniciar.
DB_NAME=clinica
DB_USER=clinica_app
DB_PASSWORD=cambiar_esta_clave
MYSQL_ROOT_PASSWORD=cambiar_clave_root
MYSQL_PORT=3306
FRONTEND_PORT=4200

# Clave Base64 para firmar JWT; genera una propia antes de iniciar.
JWT_SECRET=REEMPLAZAR_POR_UNA_CLAVE_BASE64_ALEATORIA_DE_64_BYTES

# SMTP opcional (necesario para login por OTP por correo)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO=
SMTP_AUTH=false
SMTP_SSL=false
SMTP_STARTTLS=false

# Orígenes Angular separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200

# En base nueva se crea un administrador inicial si configuras los tres valores.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@clinica.local
BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_FUERTE

# SOLO para desarrollo local sin SMTP: imprime el OTP en `docker compose logs app`.
# Mantener en false en cualquier entorno compartido o desplegado.
OTP_CONSOLE_MODE=false

# Para compose.external.yaml: host o IP de MySQL accesible desde Docker.
DB_HOST=host.docker.internal
DB_PORT=3306
